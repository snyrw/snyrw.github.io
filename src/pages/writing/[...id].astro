---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, isoDate, longDate } from '../../lib/util';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <h1 class="page-title">{post.data.title}</h1>
    <p class="meta"><time datetime={isoDate(post.data.date)}>{longDate(post.data.date)}</time></p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
