---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getNotes, isoDate, longDate } from '../lib/util';

const notes = await Promise.all(
  (await getNotes()).map(async (note) => ({ note, Content: (await render(note)).Content }))
);
---

<Base title="Notes">
  <h1 class="page-title">Notes</h1>
  {notes.map(({ note, Content }) => (
    <section class="note" id={note.id}>
      <p class="meta">
        <a href={`#${note.id}`}><time datetime={isoDate(note.data.date)}>{longDate(note.data.date)}</time></a>
      </p>
      {note.data.title && <h2>{note.data.title}</h2>}
      <div class="prose">
        <Content />
      </div>
    </section>
  ))}
</Base>
